{% extends 'admin/_layout.html.twig' %}
{% import 'admin/_macros.html.twig' as m %}

{% block page_title %}Categories{% endblock %}

{% block admin_content %}
    <div class="admin-page">
        <div class="admin-page__head">
            <div>
                <h1 class="admin-page__title">Categories</h1>
                <p class="admin-page__subtitle">Hierarchical tree · parent categories can nest children</p>
            </div>
            <a href="{{ path('admin_category_new', { locale: locale }) }}" class="btn btn--primary" style="margin-left:auto;">New category</a>
        </div>

        <div class="filters-bar">
            <form method="get" class="search-field">
                {{ include('admin/_icon.html.twig', { name: 'search' }) }}
                <input type="search" name="q" value="{{ query }}" placeholder="Search category">
                <input type="hidden" name="status" value="{{ status }}">
                <input type="hidden" name="locale" value="{{ locale }}">
            </form>
            <form method="get" onchange="this.submit()">
                <input type="hidden" name="q" value="{{ query }}">
                <input type="hidden" name="locale" value="{{ locale }}">
                <select name="status" class="select">
                    <option value="all" {{ status == 'all' ? 'selected' }}>All statuses</option>
                    <option value="1" {{ status == '1' ? 'selected' }}>Active</option>
                    <option value="0" {{ status == '0' ? 'selected' }}>Inactive</option>
                </select>
            </form>
            <div class="locale-switch">
                {% for l in locales %}
                    <a href="{{ path('admin_categories', { locale: l.value, q: query, status: status }) }}" class="{{ locale == l.value ? 'is-active' }}">{{ l.value }}</a>
                {% endfor %}
            </div>
        </div>

        <div class="table-card">
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Store</th>
                            <th>Parent</th>
                            <th class="right">Products</th>
                            <th>Locales</th>
                            <th>Status</th>
                            <th class="right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            {% set category = row.category %}
                            {% set info = category.categoryInfos.first %}
                            <tr>
                                <td>
                                    <span style="display:flex; align-items:center; gap:8px; padding-left: {{ row.depth * 22 }}px;">
                                        {% if row.depth > 0 %}<span style="color:var(--stone-300);">└</span>{% endif %}
                                        <span>
                                            <span class="cell-title">{{ info ? info.title : '— no ' ~ locale ~ ' content —' }}</span>
                                            {% if info %}<span class="cell-sub mono">/{{ info.slug }}</span>{% endif %}
                                        </span>
                                    </span>
                                </td>
                                <td>{{ category.store.title }}</td>
                                <td>{{ category.parent ? (category.parent.categoryInfos.first ? category.parent.categoryInfos.first.title : '#' ~ category.parent.id) : '—' }}</td>
                                <td class="right tabular-nums">{{ category.products.count }}</td>
                                <td>
                                    <span class="tag-row">
                                        {% for ci in category.categoryInfos %}<span class="tag">{{ ci.locale }}</span>{% endfor %}
                                    </span>
                                </td>
                                <td>{{ m.status_badge(category.status) }}</td>
                                <td class="right"><a href="{{ path('admin_category_edit', { id: category.id, locale: locale }) }}" class="btn--link">Edit</a></td>
                            </tr>
                        {% else %}
                            <tr><td colspan="7" class="empty-state">No categories match these filters.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
